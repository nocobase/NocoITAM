+// Patched in NocoITAM (2026-11-10) until the plugin fixes it: registered paths are absolute, so each is nested
+// relative to its parent's, as the application's router does (template relativeRoutePath / childRouteParentPath).
+// Nested groups sharing their parent's path, such as the System settings categories, made matchRoutes throw.
+function entryRoutes(routes, parentPath = '') {
+    return routes.map((route) => {
+        const own = route.path.replace(/\/$/, '');
+        const inside = parentPath.startsWith(`${own}/`);
+        const path = !parentPath
+            ? route.path
+            : route.path === parentPath || inside
+                ? ''
+                : route.path.slice(parentPath === '/' ? 1 : parentPath.length + 1);
+        return {
+            path,
+            handle: route.auth,
+            children: entryRoutes(route.children ?? [], inside ? parentPath : route.path),
+        };
+    });

{
  "extends": "@nocobase/dev-config/tsconfig/node-tooling.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "cli/**/*.ts",
    // Application change (ITAM): development scripts such as `data-reset.ts`,
    // which must stay out of the server build.
    "scripts/**/*.ts",
    "playwright.config.ts",
    "tests/playwright/**/*.ts"
  ]
}

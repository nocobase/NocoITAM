{
  "extends": "@nocobase/dev-config/tsconfig/client.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    // Application change (ITAM): the application's own code still imports
    // through `@/` (hundreds of files); the template's `#components/*` …
    // package imports work beside it.
    "paths": {
      "@/*": ["./client/*"]
    }
  },
  "include": ["client"],
  "exclude": ["registry"]
}

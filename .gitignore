node_modules/
dist/
coverage/

# Local configuration, including the generated AUTH_SECRET.
/config.yml
# Local secrets (model API keys) that config.yml refers to as ${...}.
.env
.env.*
!.env.example

# Collection artifacts: what the database currently resolves each
# Collection to, written by `nocobase collections generate` and refreshed by
# `db apply` and `pnpm dev`. A local cache for every connection — safe to
# delete, never read back. An external connection's hand-written
# `database/<connection>/metadata/` is committed; this is not.
database/*/collections/

# Local application state.
/storage/
/.agents/
/.agent-annotations/
/.nocobase/
*.log

# macOS folder metadata.
.DS_Store
/nocosolution/
